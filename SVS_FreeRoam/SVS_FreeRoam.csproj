<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<OutputType>Library</OutputType>
		<AssemblyName>SVS_FreeRoam</AssemblyName>
		<RootNamespace>SVS_FreeRoam</RootNamespace>
		<!-- Writes these into the DLL, so Windows' file properties show the real version. -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<Product>SVS_FreeRoam</Product>
		<AssemblyTitle>SVS_FreeRoam</AssemblyTitle>
		<Description>Free roam for Summer Vacation Scramble: third-person camera and controls, gamepad, click-to-walk. A rework of SVS_3rdPov by Junh2x.</Description>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.752" />
	</ItemGroup>

	<!--
		The interop assemblies are generated by BepInEx from the game on first launch and are
		not redistributable, so they are referenced from the local install rather than committed.
		Anyone else building this points InteropPath at their own install, e.g.
		dotnet build -p:InteropPath="E:\Games\SVS\BepInEx\SamabakeScramble\interop"
	-->
	<PropertyGroup>
		<InteropPath Condition="'$(InteropPath)' == ''">D:\Games\SamabakeScrambleTest\BepInEx\SamabakeScramble\interop</InteropPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="$(InteropPath)\*.dll">
			<Private>false</Private>
		</Reference>
	</ItemGroup>
</Project>
